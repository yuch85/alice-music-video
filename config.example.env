# Music Video Pipeline Configuration
# Copy to .env and adjust for your environment.
# Most tools read these via os.environ.get().

# Demucs (stem separation)
# Install: pip install demucs or use a venv
DEMUCS_BIN=/path/to/demucs

# ComfyUI
# https://github.com/comfyanonymous/ComfyUI
COMFYUI_DIR=/path/to/ComfyUI
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8199

# GPU Manager (optional — for VRAM arbitration + slingshot)
# Not required for basic pipeline operation.
GPU_MANAGER_HOST=127.0.0.1
GPU_MANAGER_PORT=8090
GPU_MANAGER_DIR=/path/to/gpu-manager

# Project directory (your music video project root)
MV_PROJECT_DIR=/path/to/your/music-video-project

# Local LLM (for prompt refinement — optional)
# Used by mv_prompt.py for two-stage LLM refinement.
LOCAL_LLM_ENDPOINT=http://127.0.0.1:8029/v1
LOCAL_LLM_MODEL=qwen3.6-35b-a3b

# HuMo post-processing models
HUMO_REALESRGAN_MODEL=/path/to/ComfyUI/models/upscale_models/4x-UltraSharp.pth
HUMO_REALESRGAN_FALLBACK=/path/to/ComfyUI/models/upscale_models/RealESRGAN_x4plus.pth

# Fonts (for subtitle burning)
MV_JP_FONT=/path/to/NotoSansCJKjp-Regular.otf

# Assembly inputs (for burn_subs_and_credits)
MV_TRANSCRIPT=transcript.json
MV_OUTPUT_DIR=output/
MV_INPUT_VIDEO=input.mp4
MV_ARTIFACT_DIR=/path/to/artifacts

# CUDA / FFmpeg
# Add CUDA libs to LD_LIBRARY_PATH if demucs/ComfyUI need them
# LD_LIBRARY_PATH=/usr/local/cuda/lib64

# Pipeline behavior
MV_PLAN_MISMATCH=recover
MV_TEXT_ENCODER_CPU=0
TQDM_DISABLE=1

# Moot-bench (for alice-lipsync skill — optional)
MOOT_BENCH_DIR=/path/to/moot-bench
